{
  "name": "web",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "test:watch": "bun test --watch",
    "test": "bun test --coverage",
    "sops:encrypt": "sops encrypt --input-type binary --output-type json --filename-override .env.local.enc.json --output .env.local.enc.json .env.local",
    "sops:decrypt": "umask 077 && SOPS_AGE_KEY_FILE=\"${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}\" sops decrypt --input-type json --output-type binary --output .env.local .env.local.enc.json && chmod 600 .env.local",
    "sops:updatekeys": "SOPS_AGE_KEY_FILE=\"${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}\" sops updatekeys --yes .env.local.enc.json"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.9.0",
    "@sanity/webhook": "^4.0.4",
    "get-youtube-id": "^1.0.1",
    "groq": "^6.19.0",
    "modern-normalize": "^3.0.1",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-masonry-css": "^1.0.16",
    "sass": "^1.105.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@next/bundle-analyzer": "^16.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "bun": "^1.4.3",
    "postcss-preset-env": "^11.6.1",
    "typescript": "^6.0.3"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "private": true
}
