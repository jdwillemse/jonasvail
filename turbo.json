{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NEXT_PUBLIC_SANITY_PROJECT_ID", "NEXT_PUBLIC_SANITY_DATASET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["SANITY_STUDIO_*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "typegen": {
      "outputs": ["schema.json", "sanity.types.ts"]
    }
  }
}
